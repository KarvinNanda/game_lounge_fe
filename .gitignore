# ── Dependencies ──────────────────────────
node_modules/

# ── Build Output ──────────────────────────
dist/
dist-ssr/

# ── Environment Variables ──────────────────
# .env dan .env.local diabaikan (berisi secret / URL lokal)
.env
.env.local
.env.*.local
# .env.production sengaja di-commit — hanya berisi URL publik, bukan secret

# ── Logs ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cache ─────────────────────────────────
.eslintcache
.cache/
*.tsbuildinfo

# ── Vite ──────────────────────────────────
*.timestamp-*-*.mjs
*.local

# ── Testing ───────────────────────────────
# Unit test files — run locally only, not committed to repo
tests/
coverage/
__screenshots__/
/cypress/videos/
/cypress/screenshots/

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
