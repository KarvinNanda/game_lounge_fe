# ── Dependencies (di-install ulang di dalam container) ────────
node_modules

# ── Git ───────────────────────────────────────────────────────
.git
.gitignore

# ── Build output (di-generate ulang oleh npm run build) ───────
dist
dist-ssr
coverage

# ── Env files (jangan masuk ke image) ─────────────────────────
# VITE_API_URL dikirim lewat build arg, bukan file .env
.env
.env.*
!.env.example

# ── Dev tooling & docs ────────────────────────────────────────
*.md
.vscode
.idea
.eslintcache
*.log

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
